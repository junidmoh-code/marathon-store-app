    {
      "type": "BUTTONS",
      "buttons": [
        {
          "type": "URL",
          "text": "Show barcode",
          "url": "https://marathon-pos.web.app/code/{{1}}",
          "example": ["https://marathon-pos.web.app/code/2291"]
        }
      ]
    }
  ]
}
