rules_version = '2';
service firebase.storage {
  // A real staff member: the syncStaffClaim function mirrors "has a /users
  // record" into the token claim staff == true (Storage rules cannot read the
  // Realtime Database). Client sign-up is open, so "signed in and not
  // anonymous" no longer means staff — anyone can create an account. The two
  // owners are recognised by verified email as well, so they are never locked
  // out by a lagging token. Added Nov 2026 security audit.
  function isStaff() {
    return request.auth != null
      && (request.auth.token.staff == true
          || ((request.auth.token.email == "gunidmoh@gmail.com" || request.auth.token.email == "jafermohammed340@gmail.com")
              && request.auth.token.email_verified == true));
  }

  match /b/{bucket}/o {
    // Product images. Public read: photos are shown in-app and on the
    // anonymous TV board, and are non-sensitive. Writes/deletes require an
    // authenticated, non-anonymous user — this mirrors the RTDB /products
    // write rule and matches how uploads actually happen (the Add Product /
    // Edit photo screens are only reachable after a staff PIN or owner
    // sign-in; anonymous TV/pickup sessions only ever read). Tightened
    // 2026-07-02: was `write: if true`, which let anyone on the internet
    // overwrite or delete the entire product catalog with no auth.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    // TV ad creative (tv_ads/current.jpg, or a video). Public read is
    // REQUIRED, not merely convenient: the in-store TV board runs as an
    // anonymous session, so if read were gated the overlay would silently
    // never render. The file is a shop advert — it is meant to be seen by
    // the street. Write mirrors the /products block: any authenticated,
    // non-anonymous staff account may replace the creative, deliberately
    // NOT restricted to the super-admin, so any admin can swap the ad
    // without waiting on the owner. Storage rules cannot read the RTDB, so
    // a stockRole == 'admin' check is not expressible here; if this ever
    // needs to be admin-only it has to move behind a callable that writes
    // with the Admin SDK, the way cardRecon does.
    match /tv_ads/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    // AI Studio Style Kit reference images (aiStudio/styleKit/{template}/…).
    // Public read (non-sensitive scene photos; the generate function fetches
    // them by URL). Writes restricted to the super-admin — these refs drive
    // EVERY house-style generation store-wide, so a non-super-admin staff user
    // must not be able to overwrite/delete them via the Storage SDK. Mirrors
    // ADMIN_EMAIL (functions assertAdmin / PermissionsContext) and the
    // broadcast-media gate below, rather than relying on the UI gate alone.
    match /aiStudio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && ((request.auth.token.email == "gunidmoh@gmail.com" || request.auth.token.email == "jafermohammed340@gmail.com") && request.auth.token.email_verified == true);
    }
    // Card-recon slip photos: cardRecon/{draftId}/photo-{i}.jpg — the
    // photographed FNB batch report. Its detail roll carries a masked PAN, an
    // auth code and an RRN for EVERY transaction in a batch, alongside the
    // till's takings: investigation material about named staff, not product
    // photography. So read is limited to holders of the existing `card_recon`
    // permission rather than to every signed-in staff member (which is what a
    // plain `request.auth != null` would mean here, and what the rest of this
    // file's public-read blocks deliberately are).
    //
    // Storage rules cannot read the Realtime Database, so the permission
    // cannot be checked where it lives (/users/{uid}/permFlags/card_recon).
    // It is mirrored into a Firebase Auth custom claim by syncCardReconClaim
    // (functions/cardRecon/cardReconClaim.js), which is that claim's ONLY
    // writer and which REMOVES the claim on revoke — a claim left standing
    // after a permission is taken away is worse than no gate at all, because
    // the app then says the person cannot see these and the bucket still hands
    // them over. `== true` deliberately: an absent claim is undefined, and a
    // legacy `false` must not read as presence.
    //
    // The super-admin clause mirrors the aiStudio / broadcast-media blocks
    // below and the callable's own ADMIN_EMAIL bypass, so the owner is never
    // locked out of their own evidence by a lagging token refresh.
    //
    // WRITE STAYS FALSE, for everyone. The cardBatchCapture callable writes
    // these with the Admin SDK, which bypasses rules entirely; no client ever
    // writes, overwrites or deletes here. That is what makes a slip photo
    // evidence rather than a file someone could replace.
    match /cardRecon/{allPaths=**} {
      allow read: if request.auth != null
                  && (request.auth.token.card_recon == true
                      || ((request.auth.token.email == "gunidmoh@gmail.com" || request.auth.token.email == "jafermohammed340@gmail.com") && request.auth.token.email_verified == true));
      allow write: if false;
    }
    // card_recon_refused/{intakeId}.pdf — the original PDF the mailbox poller
    // could not record, so Junid can see what the file said without digging
    // through the mailbox. OWNER ONLY: a refused report carries the same masked
    // PANs, auth codes and RRNs as the slips above, and managers see nothing of
    // a refusal but its redacted sentence. Written by the poller with the Admin
    // SDK; no client ever writes here. (In the repo since the intake-evidence
    // work but never published; published with the Nov 2026 audit.)
    match /card_recon_refused/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.token.email == "gunidmoh@gmail.com"
                  && request.auth.token.email_verified == true;
      allow write: if false;
    }

    // Broadcast media. Public read so the broadcast VM can fetch
    // unauthenticated; write restricted to the admin email (tightened in
    // Phase 1.5 once Google Sign-In was live).
    match /broadcast-media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && ((request.auth.token.email == "gunidmoh@gmail.com" || request.auth.token.email == "jafermohammed340@gmail.com") && request.auth.token.email_verified == true);
    }
    // ─── RECYCLER RAW SERVICE LOGS ──────────────────────────────────────────
    // logs/recycler/{terminalId}/{YYYY-MM-DD}/{stamp}-{window}.jsonl.gz, written
    // by the kiosk (src/recycler/logShipper.js) and read by the two agents on
    // the Mac mini — the evening review and the incident watcher — which use a
    // service account and so bypass these rules entirely.
    //
    // ADDED 2026-09-20, and the reason is the whole point of the node. There
    // was no block here at all. Storage rules default-deny, so EVERY upload
    // since PR #375 went live was refused — and logShipper is written to treat
    // a failed upload as "later", silently, for ever. The bucket's logs/ prefix
    // was still empty on the morning two money incidents needed it, and the
    // only copy of the evidence was a browser window on the kiosk.
    //
    // CREATE ONLY. A kiosk may write a chunk that does not yet exist and may
    // never overwrite or delete one: evidence that can be replaced is not
    // evidence, and a till is the least trusted writer in the building.
    // Read is any signed-in, non-anonymous staff member — it carries no card
    // and no customer data, only machine detail — so the hardware page can show
    // a day back to whoever is standing at the machine.
    match /logs/{allPaths=**} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}

