node_modules
dist
.firebase
.DS_Store
*.log
# The scheduled reconciler's working directory on the Mac mini: rotated logs,
# its single-flight lockfile and its failure-counter state. Machine-local by
# definition — never committed (scripts/shopify/MAC-MINI-SETUP.md).
logs/
.env
.env.local
.env.*.local

.claude/

*-firebase-adminsdk-*.json
service-account*.json
*-credentials.json

# Phase 1 auth seed — PINs file must never enter git history.
# The script itself is safe to track (no secrets); only the data file holds PINs.
scripts/seedUsers.pins.json
scripts/targets/out/

# LIVE RTDB rules backups. The backup a rules script takes is the complete live
# ENFORCEMENT document, and this repo is PUBLIC — while database.rules.json here
# is stale, so a committed backup is the first accurate public copy of who may
# read what. Newer scripts write them to the home directory instead
# (scripts/cardrecon/apply-card-intake-rules.mjs); this stops one arriving here
# by another route. The six already tracked are left alone — untracking them
# does not unpublish them, and that is the owner's call, not a tidy-up.
rules-live-backup-*.json

# Census / model output — machine-local working data, regenerated on demand
# (scripts/model-category-policy.mjs writes here). Never committed.
var/

# REAL FNB BATCH REPORTS — the card-recon regression corpus. Kept on the Mac
# mini ONLY: they print card numbers (first six, last four), auth codes and
# RRNs, and this repo is public (Junid, 15 Oct 2026). The corpus tests skip
# cleanly where the folder is absent, which is everywhere but the mini.
functions/test/fixtures/card-recon-real/
functions/test/fixtures/Till2FNB-Txn-Notification.expected.json
functions/test/fixtures/Till2FNB-Txn-Notification.lines.json
functions/test/fixtures/Till3-Batch81-Empty-FNB-Txn-Notification.expected.json
functions/test/fixtures/Till3-Batch81-Empty-FNB-Txn-Notification.lines.json
