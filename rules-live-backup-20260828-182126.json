          ".validate": true
        }
      }
    },
    "duplicate_candidates": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      ".indexOn": [
        "status"
      ],
      "$pairId": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('users').child(auth.uid).child('stockRole').exists() && (!data.exists() || auth.token.email === 'gunidmoh@gmail.com' || root.child('users').child(auth.uid).child('stockRole').val() === 'admin')",
        ".validate": "!newData.exists() || (newData.hasChildren(['productIdA','productIdB','reason','detectedAt']) && root.child('products').child(newData.child('productIdA').val()).exists() && root.child('products').child(newData.child('productIdB').val()).exists() && newData.child('productIdA').val() !== newData.child('productIdB').val())",
        "productIdA": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "productIdB": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().matches(/^(styleCodeCollision|manual|heuristic)$/)"
        },
        "styleCodeNormalised": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "detectedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000"
        },
        "detectedBy": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(open|merged|dismissed)$/)"
        },
        "$other": {
          ".validate": true
        }
      }
