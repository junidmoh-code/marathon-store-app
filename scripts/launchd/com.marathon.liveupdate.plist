<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for scripts/launchd/live-update.mjs: every 5 minutes it moves
  ~/marathon-store-app to origin/main when (and only when) that is a plain
  fast-forward of an unedited checkout, under the reconciler's own run lock,
  and rolls back if the new code does not install or parse. Read the header of
  live-update.mjs before installing.

  KeepAlive + ThrottleInterval, NOT StartInterval: the same choice as
  com.marathon.shopifyreconcile (on 2026-08-31 launchd silently stopped firing
  every StartInterval agent in the session). The script runs once and exits.

  NOT INSTALLED BY MERGING THIS FILE. To see what it would do, changing nothing:
    node scripts/launchd/live-update.mjs --dry-run
  INSTALL (once, by hand — after that nobody pulls by hand again):
    cp scripts/launchd/com.marathon.liveupdate.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.marathon.liveupdate.plist
  Its log: logs/live-update.log (one "up to date" line an hour, every update,
  every refusal once, every failure). git needs no credential the mini does
  not already have: it fetches origin over the remote this checkout uses now.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marathon.liveupdate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/marathonclub/marathon-store-app/scripts/launchd/live-update.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/marathonclub/marathon-store-app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/marathonclub/marathon-store-app/logs/live-update.out.log</string>
  <key>StandardErrorPath</key><string>/Users/marathonclub/marathon-store-app/logs/live-update.err.log</string>
</dict>
</plist>
