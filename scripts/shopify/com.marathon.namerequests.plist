<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the new-name request server.

  WHY IT EXISTS. The reconciler refuses a publish when the storefront address a
  name produces already belongs to another listing, and records a request for a
  fresh name on the node. Until this agent, the only thing that served those
  requests was a person remembering to run a script — and a feature that only
  works when a human intervenes is not built (owner spec).

  WHY IT IS SEPARATE FROM com.marathon.visionnaming. That agent drives the
  naming BACKLOG: thousands of products, hours, real money, and it is meant to
  be started deliberately. This one serves the handful of products the machine
  itself asked about. Putting the backlog on an hourly timer to cure the
  occasional collision would be a spending decision nobody made.

  COST. A tick with no requests exits before a single model call — one RTDB walk
  and a node boot. Requests only appear on a handle collision, which is rare.
  The script's own REQ_CAP refuses to spend unattended above 50 in one pass.

  WHERE IT RUNS. The same checkout as the naming agent
  (/Users/junidmohammed/naming-run), because that is where GEMINI_API_KEY lives
  — in a git-ignored .env read by scripts/shopify/env.mjs. NOTHING SECRET IS IN
  THIS FILE; it is committed. Only paths appear here, never values.

  INSTALL:
    cp scripts/shopify/com.marathon.namerequests.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.marathon.namerequests.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.marathon.namerequests.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marathon.namerequests</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/junidmohammed/naming-run/scripts/shopify/serve-name-requests.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/junidmohammed/naming-run</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/junidmohammed</string>
  </dict>
  <!-- Hourly. A collision is not urgent enough to poll harder, and an idle tick
       is free. -->
  <key>StartInterval</key><integer>3600</integer>
  <!-- FALSE, unlike the reconciler's. Loading this agent — after a reboot, or
       while installing it — must not start a run that spends money at a moment
       nobody chose. The first tick is an hour away, and nothing is waiting on
       it that was not already waiting. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/junidmohammed/naming-run/logs/namerequests.out.log</string>
  <key>StandardErrorPath</key><string>/Users/junidmohammed/naming-run/logs/namerequests.err.log</string>
</dict>
</plist>
