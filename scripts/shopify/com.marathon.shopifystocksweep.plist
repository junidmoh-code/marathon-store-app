<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the nightly Shopify stock-truth sweep (Mac mini, 2026-10-11,
  docs/SHOPIFY-STOCK-TRUTH.md). The same mechanism as com.marathon.shopifyreconcile:
  a user LaunchAgent with KeepAlive + ThrottleInterval, never StartInterval or
  StartCalendarInterval — those silently stopped firing on 2026-08-31 while the
  KeepAlive agent survived. launchd respawns stock-truth-runner.mjs at most every
  10 minutes; it exits at once unless a sweep is due (02:30 SAST, once a day).

  INSTALL (on the mini):
    cp scripts/shopify/com.marathon.shopifystocksweep.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.marathon.shopifystocksweep.plist

  CREDENTIALS: paths only. Shopify credentials come from the git-ignored .env at
  the repo root; Firebase Admin from the service account the reconciler uses.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marathon.shopifystocksweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/marathonclub/marathon-store-app/scripts/shopify/stock-truth-runner.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/marathonclub/marathon-store-app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>GOOGLE_APPLICATION_CREDENTIALS</key><string>/Users/marathonclub/.config/marathon/shopify-reconciler-sa.json</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/marathonclub/marathon-store-app/logs/launchd-stocksweep.out.log</string>
  <key>StandardErrorPath</key><string>/Users/marathonclub/marathon-store-app/logs/launchd-stocksweep.err.log</string>
</dict>
</plist>
