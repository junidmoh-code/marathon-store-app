<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TikTok handoff queue server (scripts/social/tiktok-queue-server.mjs) on 127.0.0.1:8798.
     Tailscale Funnel maps https://mac-mini-von-marathon-3.tail5a5180.ts.net/studio/tiktok-queue
     here. Always on; launchd restarts it if it dies. docs/tiktok-queue.md.
     Install: bash scripts/social/install-tiktok-queue.sh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marathon.tiktokqueue.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/marathonclub/marathon-social/scripts/social/tiktok-queue-server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/marathonclub/marathon-social</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/marathonclub/marathon-social/logs/tiktok-queue-server.log</string>
  <key>StandardErrorPath</key><string>/Users/marathonclub/marathon-social/logs/tiktok-queue-server.log</string>
</dict>
</plist>
