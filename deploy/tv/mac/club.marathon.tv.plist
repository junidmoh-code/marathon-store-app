<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install-mac.sh fills in __SCRIPT__ and __LOG__ and loads it.
     Starts the TV board at login and starts it again if it ever stops. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>club.marathon.tv</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__SCRIPT__</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict>
</plist>
