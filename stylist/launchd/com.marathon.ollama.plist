<?xml version="1.0" encoding="UTF-8"?>
<!--
  The local stylist's model server (Mac mini). `ollama serve` from the
  Ollama.app installed in ~/Applications (no Homebrew), bound to localhost
  only. KeepAlive restarts it if it dies and RunAtLoad starts it at login, so
  it survives a reboot. OLLAMA_KEEP_ALIVE=3m unloads the model three minutes
  after the stylist's last call, so its ~10 GB is back for the other jobs for
  the rest of the day. One model, one request at a time.
  Installed by stylist/install-on-mac-mini.sh.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marathon.ollama</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/marathonclub/Applications/Ollama.app/Contents/Resources/ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key><string>127.0.0.1:11434</string>
    <key>OLLAMA_KEEP_ALIVE</key><string>3m</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key><string>1</string>
    <key>OLLAMA_NUM_PARALLEL</key><string>1</string>
    <key>HOME</key><string>/Users/marathonclub</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/marathonclub/.marathon-stylist/ollama.log</string>
  <key>StandardErrorPath</key><string>/Users/marathonclub/.marathon-stylist/ollama.log</string>
</dict>
</plist>
